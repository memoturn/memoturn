# memoturn reverse proxy — single public entrypoint for the single-VM production stack.
# Caddy auto-provisions a TLS cert (Let's Encrypt) for MEMOTURN_DOMAIN. Requirements:
#   - DNS A/AAAA record for MEMOTURN_DOMAIN points at this VM
#   - ports 80 and 443 are reachable from the internet (ACME HTTP/TLS challenge)
#
# Routing mirrors the dev Vite proxy (apps/console/vite.config.ts): `/api/*` is forwarded to
# the API with the `/api` prefix stripped (handle_path), so /api/v1/* -> /v1/* and
# /api/auth/* -> /auth/*. Everything else serves the console SPA.
#
# Root-level `/auth/*` is ALSO forwarded to the API (path intact): Better Auth mounts at
# basePath `/auth` (AUTH_BASE_URL is the origin, no `/api`), so the absolute links it emits —
# magic-link verify, OAuth authorize/callback, JWKS, discovery — live at https://DOMAIN/auth/*.
# Those must reach the API, not the SPA. The console still calls /api/auth/* (Caddy strips
# `/api` -> /auth/*), so both entry paths land on the same Better Auth handler.

{
	email {$ACME_EMAIL}
}

{$MEMOTURN_DOMAIN} {
	handle_path /api/* {
		reverse_proxy api:3001
	}

	# Better Auth's public surface (magic-link verify, OAuth authorize/callback, JWKS, its own
	# discovery docs) lives at the domain root under /auth/* — forward it to the API, path intact.
	handle /auth/* {
		reverse_proxy api:3001
	}

	# OAuth discovery for remote MCP clients — served by the API at the domain root (not the
	# console), so route these two well-known paths straight to the API with the path intact.
	# (`handle` accepts a single matcher token, hence the named matcher for both paths.)
	@oauthDiscovery path /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/openid-configuration
	handle @oauthDiscovery {
		reverse_proxy api:3001
	}

	handle {
		# Defense-in-depth CSP for the console document (where user-controlled trace/LLM
		# content renders). Tuned for the bundled Vite SPA — images allow data:/blob: for
		# inline media, styles allow 'unsafe-inline' for Tailwind/chart styles. The ONLY
		# external origins are Google gtag/GA4 collect endpoints for the public demo's
		# analytics (apps/console/src/lib/analytics.ts; inert unless the image was built
		# with VITE_GA_MEASUREMENT_ID). Deliberately gtag, not GTM: no dynamically
		# configurable tag injection on the surface that renders untrusted trace content.
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		reverse_proxy console:3000
	}
}
