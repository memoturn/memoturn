---
type Props = {
  kicker?: string;
  title: string;
  href?: string;
  code?: string;
  lang?: string;
};

const { kicker, title, href, code } = Astro.props;
---

<section class="m-hero-card">
	<div class="m-hero-card__copy">
		{kicker && <span class="m-hero-card__kicker">{kicker}</span>}
		{
			href ? (
				<a class="m-hero-card__title-link" href={href}>
					<h2 class="m-hero-card__title">{title}</h2>
				</a>
			) : (
				<h2 class="m-hero-card__title">{title}</h2>
			)
		}
		<div class="m-hero-card__body">
			<slot />
		</div>
	</div>
	{
		code && (
			<button type="button" class="m-hero-card__code" data-command={code} aria-label={`Copy command: ${code}`}>
				<code class="m-hero-card__code-text">{code}</code>
				<span class="m-hero-card__code-icon m-hero-card__code-icon--copy" aria-hidden="true">
					<svg
						width="15"
						height="15"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
						<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
					</svg>
				</span>
				<span class="m-hero-card__code-icon m-hero-card__code-icon--check" aria-hidden="true">
					<svg
						width="15"
						height="15"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M20 6 9 17l-5-5" />
					</svg>
				</span>
				<span class="m-hero-card__code-status sr-only" aria-live="polite" data-copy-status />
			</button>
		)
	}
</section>

<style>
	.m-hero-card {
		display: grid;
		gap: 1.25rem;
		padding: 1.75rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--docs-line);
		background: var(--docs-panel-bg);
		margin-block: 2.25rem 1.5rem;
	}

	@media (min-width: 720px) {
		.m-hero-card {
			grid-template-columns: 1.1fr 0.9fr;
			align-items: center;
			padding: 2rem 2.25rem;
			gap: 2rem;
		}
	}

	.m-hero-card__copy {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.m-hero-card__kicker {
		font-size: 0.69rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--kicker);
	}

	.m-hero-card__title-link {
		text-decoration: none;
		color: inherit;
		display: inline-block;
	}

	.m-hero-card__title-link:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 3px;
		border-radius: var(--radius-sm);
	}

	.m-hero-card__title {
		margin: 0;
		font-family: var(--font-heading-stack);
		font-size: clamp(1.5rem, 2.6vw, 1.75rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}

	.m-hero-card__title-link:hover .m-hero-card__title {
		color: var(--primary);
	}

	.m-hero-card__body {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--muted-foreground);
	}

	.m-hero-card__body :global(p) {
		margin: 0;
	}

	.m-hero-card__body :global(code) {
		font-family: var(--font-mono-stack);
		font-size: 0.85em;
		font-weight: 500;
		line-height: 1.5;
		background: var(--muted);
		color: var(--primary);
		border-radius: calc(var(--radius) * 0.4);
		padding: 0.1em 0.35em;
	}

	/* Click-to-copy command block: the whole panel is the affordance, with a
	 * copy icon that flips to a check on success. Copy is wired by the shared
	 * delegated handler (data-command), so it survives view transitions. */
	.m-hero-card__code {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		margin: 0;
		padding: 0.85rem 1rem;
		background: var(--background);
		border: 1px solid var(--docs-line);
		border-radius: var(--radius-md);
		font-family: var(--font-mono-stack);
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--foreground);
		text-align: left;
		cursor: pointer;
		transition:
			border-color 180ms var(--ease-swell, ease),
			background-color 180ms var(--ease-swell, ease);
	}

	.m-hero-card__code:hover {
		border-color: color-mix(in oklab, var(--primary) 45%, var(--docs-line));
	}

	.m-hero-card__code:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 3px;
	}

	.m-hero-card__code.is-copied {
		border-color: color-mix(in oklab, var(--primary) 55%, var(--docs-line));
	}

	.m-hero-card__code-text {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* Each icon SVG lives inside a fixed 15px box: a bare SVG as a flex item
	 * carries a phantom intrinsic height that inflates the row and drops the
	 * glyph, so the overflow-clipped HTML box is the flex item instead and the
	 * copy → check swap stays centered on the command line. */
	.m-hero-card__code-icon {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 15px;
		height: 15px;
		overflow: hidden;
		line-height: 0;
		color: var(--muted-foreground);
		transition: color 180ms var(--ease-swell, ease);
	}

	.m-hero-card__code-icon svg {
		display: block;
		width: 15px;
		height: 15px;
	}

	.m-hero-card__code:hover .m-hero-card__code-icon {
		color: var(--primary);
	}

	.m-hero-card__code-icon--check {
		display: none;
	}

	.m-hero-card__code.is-copied .m-hero-card__code-icon--copy {
		display: none;
	}

	.m-hero-card__code.is-copied .m-hero-card__code-icon--check {
		display: inline-flex;
		color: var(--primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.m-hero-card__code,
		.m-hero-card__code-copy {
			transition: none;
		}
	}
</style>

<script>
	import { initCopyToClipboard } from "./copy-to-clipboard.ts";

	initCopyToClipboard();
</script>
