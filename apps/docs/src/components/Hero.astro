---
import { Image } from "astro:assets";

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {};

const imageAttrs = {
  loading: "eager" as const,
  decoding: "async" as const,
  width: 400,
  height: 400,
  alt: image?.alt || "",
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
  if ("file" in image) {
    lightImage = image.file;
  } else if ("dark" in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else {
    rawHtml = image.html;
  }
}
---

<div class="memoturn-hero">
	<div class="memoturn-hero__grid" aria-hidden="true"></div>
	<div class="memoturn-hero__content">
		{
			lightImage && (
				<Image
					src={lightImage}
					{...imageAttrs}
					class:list={["memoturn-hero__image", { "light:sl-hidden": darkImage }]}
				/>
			)
		}
		{
			darkImage && (
				<Image
					src={darkImage}
					{...imageAttrs}
					class:list={["memoturn-hero__image", "dark:sl-hidden"]}
				/>
			)
		}
		{rawHtml && <div class="memoturn-hero__image" set:html={rawHtml} />}

		<div class="memoturn-hero__copy">
			<p class="memoturn-hero__eyebrow">
				<svg class="memoturn-hero__mark" viewBox="0 0 128 128" role="img" aria-label="Memoturn" fill="none">
					<defs>
						<linearGradient id="memoturn-hero-mark-grad" x1="0" y1="0" x2="1" y2="1">
							<stop offset="0%" stop-color="#4fb8b2" />
							<stop offset="100%" stop-color="#328f97" />
						</linearGradient>
					</defs>
					<g fill="url(#memoturn-hero-mark-grad)">
						<path fill-rule="evenodd" d="M 64 10 a 54 54 0 1 0 0 108 a 54 54 0 1 0 0 -108 M 64 24 a 40 40 0 1 1 0 80 a 40 40 0 1 1 0 -80" />
						<path fill-rule="evenodd" d="M 64 34 a 30 30 0 1 0 0 60 a 30 30 0 1 0 0 -60 M 64 48 a 16 16 0 1 1 0 32 a 16 16 0 1 1 0 -32" />
						<circle cx="64" cy="64" r="8" />
					</g>
				</svg>
				<span>open source · Apache-2.0</span>
			</p>
			<h1 class="memoturn-hero__title" set:html={title} />
			{tagline && <p class="memoturn-hero__tagline" set:html={tagline} />}
			{
				actions.length > 0 && (
					<div class="memoturn-hero__actions">
						{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<a
								{href}
								class:list={[
									"memoturn-hero__action",
									`memoturn-hero__action--${variant}`,
									className,
								]}
								{...attrs}
							>
								<span set:html={text} />
								{icon?.html && <span class="memoturn-hero__action-icon" set:html={icon.html} />}
							</a>
						))}
					</div>
				)
			}
			<dl class="memoturn-hero__meta">
				<div>
					<dt class="sr-only">License</dt>
					<dd>Apache-2.0</dd>
				</div>
				<div>
					<dt class="sr-only">Telemetry</dt>
					<dd>OpenTelemetry-native</dd>
				</div>
				<div>
					<dt class="sr-only">SDKs</dt>
					<dd>TS + Python + Go</dd>
				</div>
				<div>
					<dt class="sr-only">Analytics store</dt>
					<dd>Apache Doris-backed</dd>
				</div>
			</dl>
		</div>
	</div>
</div>

<style>
	.memoturn-hero {
		position: relative;
		padding-block: clamp(3rem, 8vw, 6rem);
		isolation: isolate;
		overflow: hidden;
		border-bottom: 1px solid var(--docs-line);
		/* Bleed past Starlight's content-panel padding so the hero band spans
		 * the viewport, matching the marketing site hero. */
		width: 100vw;
		margin-inline: calc(50% - 50vw);
	}

	/* Quiet 96×96 hairline grid, same vocabulary as the marketing index hero —
	 * centered + radially masked so edges don't read as stray rules. */
	.memoturn-hero__grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(to right, var(--docs-line-faint) 1px, transparent 1px),
			linear-gradient(to bottom, var(--docs-line-faint) 1px, transparent 1px);
		background-size: 96px 96px;
		background-position: center;
		-webkit-mask-image: radial-gradient(ellipse 88% 78% at 50% 45%, #000 50%, transparent 100%);
		        mask-image: radial-gradient(ellipse 88% 78% at 50% 45%, #000 50%, transparent 100%);
		pointer-events: none;
	}

	/* Match the splash content column (56rem) so the hero copy lines up
	 * with HeroCard / ChipRow / CTA below it. The hero band itself is now
	 * full-bleed, so we re-introduce inline padding here. */
	.memoturn-hero__content {
		max-width: 56rem;
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, 2rem);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.memoturn-hero__image {
		width: 56px;
		height: auto;
	}

	.memoturn-hero__copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	/* Eyebrow — the marketing hero's mono chip: teal wordmark + lowercase
	 * mono label, not a tracked all-caps kicker. Same voice as memoturn.com. */
	.memoturn-hero__eyebrow {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-mono-stack);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: var(--muted-foreground);
	}

	.memoturn-hero__mark {
		width: 1.75rem;
		height: 1.75rem;
		flex: 0 0 auto;
	}

	.memoturn-hero__title {
		margin: 0;
		font-family: var(--font-heading-stack);
		font-weight: 700;
		font-stretch: 110%;
		font-size: clamp(2.5rem, 6vw, 3.75rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--foreground);
		text-wrap: balance;
		max-width: 16ch;
	}

	.memoturn-hero__tagline {
		margin: 0;
		font-size: clamp(1rem, 1.5vw, 1.125rem);
		line-height: 1.65;
		color: var(--muted-foreground);
		text-wrap: pretty;
		max-width: 60ch;
	}

	.memoturn-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	/* Signal row — the marketing hero's mono metadata line: teal dots + short
	 * facts. Reinforces the same claims the console makes, in the same voice. */
	.memoturn-hero__meta {
		margin: 0.75rem 0 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem 1rem;
		font-family: var(--font-mono-stack);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: var(--muted-foreground);
	}

	.memoturn-hero__meta > div {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.memoturn-hero__meta > div::before {
		content: "";
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 999px;
		background: color-mix(in oklab, var(--primary) 70%, transparent);
		flex: 0 0 auto;
	}

	.memoturn-hero__meta dd {
		margin: 0;
	}

	/* Button spec matches the marketing home: 40px height, 6px radius,
	 * 14px/500 type, foam-fill primary (sea-ink fill in light mode via
	 * --docs-btn-primary-*), hairline outline secondary. */
	.memoturn-hero__action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.5rem;
		padding: 0 1.375rem;
		border-radius: var(--radius-lg);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		outline: none;
		transition:
			background-color 180ms var(--ease-swell, ease),
			border-color 180ms var(--ease-swell, ease),
			color 180ms var(--ease-swell, ease);
	}

	.memoturn-hero__action:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 3px;
	}

	.memoturn-hero__action--primary {
		background: var(--docs-btn-primary-bg);
		color: var(--docs-btn-primary-fg);
	}
	.memoturn-hero__action--primary:hover {
		background: var(--docs-btn-primary-bg-hover);
		color: var(--docs-btn-primary-fg);
	}

	.memoturn-hero__action--secondary,
	.memoturn-hero__action--minimal {
		background: transparent;
		color: var(--foreground);
		border: 1px solid var(--border);
	}
	.memoturn-hero__action--secondary:hover,
	.memoturn-hero__action--minimal:hover {
		background: var(--card);
		border-color: color-mix(in oklab, var(--foreground) 22%, transparent);
	}

	.memoturn-hero__action-icon :global(svg) {
		width: 1rem;
		height: 1rem;
	}
</style>
