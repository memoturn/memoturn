---
import CopyChip from "./CopyChip.astro";

type Props = {
  kicker?: string;
  title: string;
  primary?: { href: string; text: string };
  secondary?: { href: string; text: string };
  command?: string;
};

const { kicker, title, primary, secondary, command } = Astro.props;
---

<section class="m-cta">
	<div class="m-cta__inner">
		<div class="m-cta__pattern" aria-hidden="true"></div>
		<div class="m-cta__content">
			<span class="m-cta__mark" aria-hidden="true">
				<svg viewBox="0 0 128 128" fill="currentColor">
					<path fill-rule="evenodd" d="M 64 10 a 54 54 0 1 0 0 108 a 54 54 0 1 0 0 -108 M 64 24 a 40 40 0 1 1 0 80 a 40 40 0 1 1 0 -80" />
					<path fill-rule="evenodd" d="M 64 34 a 30 30 0 1 0 0 60 a 30 30 0 1 0 0 -60 M 64 48 a 16 16 0 1 1 0 32 a 16 16 0 1 1 0 -32" />
					<circle cx="64" cy="64" r="8" />
				</svg>
			</span>
			{kicker && <p class="m-cta__kicker">{kicker}</p>}
			<h2 class="m-cta__title">{title}</h2>
			<div class="m-cta__body">
				<slot />
			</div>
			{
				(primary || secondary || command) && (
					<div class="m-cta__actions">
						{primary && (
							<a class="m-cta__action m-cta__action--primary" href={primary.href}>
								{primary.text}
							</a>
						)}
						{secondary && (
							<a class="m-cta__action m-cta__action--secondary" href={secondary.href}>
								{secondary.text}
							</a>
						)}
						{command && <CopyChip command={command} />}
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	/* Atoll closing band, matches the marketing-surface vocabulary.
	 * One brand moment per page; this is the moment. Width inherits from the
	 * parent (splash content cap or page content area) so it lines up with
	 * the rest of the column. */
	.m-cta {
		margin-block: 3rem 1rem;
	}
	.m-cta__inner {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 3.25rem 1.5rem;
		border-radius: var(--radius-lg);
		background: var(--gradient-atoll);
		color: var(--on-gradient-fg);
	}
	@media (min-width: 768px) {
		.m-cta__inner {
			padding: 4rem 3rem;
		}
	}

	/* Topo contour wash — the marketing closing band's texture, so the empty
	 * right of the panel reads as brand surface instead of dead gradient. */
	.m-cta__pattern {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: var(--pattern-topo-light);
		background-size: 460px 460px;
		background-position: center;
		mix-blend-mode: screen;
		opacity: 0.16;
		pointer-events: none;
	}

	.m-cta__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}

	.m-cta__mark {
		display: inline-flex;
		color: var(--on-gradient-fg);
		filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.28));
	}
	.m-cta__mark svg {
		width: clamp(3rem, 6vw, 3.75rem);
		height: auto;
		transition: transform 2400ms var(--ease-swell, cubic-bezier(0.16, 1, 0.3, 1));
	}
	.m-cta__inner:hover .m-cta__mark svg {
		transform: rotate(360deg);
	}

	.m-cta__kicker {
		margin: 0;
		font-family: var(--font-mono-stack);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--on-gradient-fg-soft);
	}
	.m-cta__title {
		margin: 0;
		font-family: var(--font-heading-stack);
		font-size: clamp(1.75rem, 3.4vw, 2.5rem);
		font-weight: 700;
		font-stretch: 110%;
		line-height: 1.12;
		max-width: 20ch;
		color: var(--on-gradient-fg);
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.m-cta__body {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--on-gradient-fg-soft);
		max-width: 52ch;
		text-wrap: pretty;
	}
	.m-cta__body :global(p) {
		margin: 0;
	}
	.m-cta__body :global(a) {
		color: var(--on-gradient-fg);
		text-decoration-color: color-mix(in oklab, var(--on-gradient-fg) 60%, transparent);
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
		font-weight: 600;
		transition:
			color 180ms var(--ease-swell, ease),
			text-decoration-color 180ms var(--ease-swell, ease);
	}
	.m-cta__body :global(a:hover) {
		text-decoration-color: var(--on-gradient-fg);
	}
	.m-cta__body :global(a:focus-visible) {
		outline: 2px solid var(--on-gradient-fg);
		outline-offset: 3px;
		border-radius: var(--radius-sm);
	}
	.m-cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.m-cta__mark svg {
			transition: none;
		}
		.m-cta__inner:hover .m-cta__mark svg {
			transform: none;
		}
	}
	/* Button spec matches the marketing home's closing band: 40px height,
	 * 6px radius, 14px/500 type. */
	.m-cta__action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.5rem;
		padding: 0 1.375rem;
		border-radius: var(--radius-lg);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		outline: none;
		transition:
			background-color 180ms var(--ease-swell, ease),
			border-color 180ms var(--ease-swell, ease);
	}
	.m-cta__action:focus-visible {
		outline: 2px solid var(--on-gradient-fg);
		outline-offset: 3px;
	}
	.m-cta__action--primary {
		background: var(--on-gradient-fg);
		color: var(--sea-ink);
	}
	.m-cta__action--primary:hover {
		background: color-mix(in oklab, var(--on-gradient-fg) 90%, transparent);
	}
	/* Foam text over a sea-ink tint: darkening the fill (rather than fading
	 * the text) is what keeps this legible on the gradient. */
	.m-cta__action--secondary {
		background: color-mix(in oklab, var(--sea-ink) 45%, transparent);
		color: var(--on-gradient-fg);
		border: 1px solid color-mix(in oklab, var(--on-gradient-fg) 40%, transparent);
	}
	.m-cta__action--secondary:hover {
		background: color-mix(in oklab, var(--sea-ink) 60%, transparent);
		border-color: color-mix(in oklab, var(--on-gradient-fg) 60%, transparent);
	}
</style>
