# Serves the built console SPA (static files + history fallback). TLS and /api routing
# live in the front proxy (infra/Caddyfile on the single-VM stack; an Ingress on Helm) —
# this listener is plain HTTP behind it, matching the Helm probes on :3000.
#
# The security headers are set HERE, not only at the proxy, so a Kubernetes deployment
# (where there is no infra/Caddyfile in front) gets the same CSP on the surface that
# renders untrusted trace/LLM content. Keep the CSP in sync with infra/Caddyfile.
:3000 {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html
	file_server
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}
	# Vite content-hashes everything under /assets; everything else (the SPA document
	# under any route, favicons) must revalidate so deploys take effect immediately.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	@nonAssets not path /assets/*
	header @nonAssets Cache-Control "no-cache"
}
